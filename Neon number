public class Main {
    public static void main(String[] args) {
        int num = 9;
        int sqr = num * num;
        int sum = 0;

        while (sqr > 0) {
            int digit = sqr % 10;
            sum = sum + digit;
            sqr = sqr / 10;
        }

        if (num == sum) {
            System.out.println("The given number is neon");
        } else {
            System.out.println("The given number is not a neon");
        }
    }
}

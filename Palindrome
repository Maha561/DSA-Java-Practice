public class Main {
    public static void main(String[] args) {
        int num = 1234;
        int original = num;
        int reverse = 0;

        while (num > 0) {
            int digit = num % 10;
            reverse = (reverse * 10) + digit;
            num = num / 10;
        }

        if (original == reverse) {
            System.out.println("The given number is palindrome");
        } else {
            System.out.println("The given number is not a palindrome");
        }
    }
}

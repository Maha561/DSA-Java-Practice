public class Main {
    public static void main(String[] args) {
        int num = 4321;
        int firstDigit = 0;
        int digit = 0;

        while (num > 0) {
            digit = num % 10;
            firstDigit = digit;
            num = num / 10;
        }

        if (firstDigit % 2 == 0) {
            System.out.println("even");
        } else {
            System.out.println("odd");
        }
    }
}
